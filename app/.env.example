# Sarvam AI — https://dashboard.sarvam.ai/key-management
SARVAM_API_KEY=

# mock  → extraction runs the local deterministic parser, zero credits burned.
# live  → real calls to api.sarvam.ai.
# Per-capability overrides let you go live on cheap paths (translate, tts)
# while keeping the expensive ones (extract, ocr, stt) mocked.
SARVAM_MODE=mock
# SARVAM_MODE_EXTRACT=live
# SARVAM_MODE_OCR=live
# SARVAM_MODE_STT=live
# SARVAM_MODE_TTS=live
# SARVAM_MODE_TRANSLATE=live

SARVAM_CHAT_MODEL=sarvam-105b

# Signs the session cookie. Any long random string.
ROVELLE_SECRET=change-me

# Where the SQLite file lives.
ROVELLE_DB=./data/rovelle.db
